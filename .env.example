# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── LLM Provider ────────────────────────────────────────────────────────────
# Supported: extractive (free) | mock (test preview) | openai (paid)
# Extractive mode uses local runbooks. Semantic retrieval downloads a free model on first use.
# For no model download: RETRIEVAL_MODE=keyword, TOP_K=3, SCORE_THRESHOLD=0.55.
LLM_PROVIDER=extractive
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your-openai-api-key-here
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=30

# ── Embeddings ───────────────────────────────────────────────────────────────
# Local sentence-transformers model (no API key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_PROVIDER=local

# ── Vector Store ─────────────────────────────────────────────────────────────
VECTOR_STORE_PATH=./vectorstore
VECTOR_STORE_COLLECTION=it_support_kb

# ── Retrieval ────────────────────────────────────────────────────────────────
RETRIEVAL_MODE=semantic
RETRIEVAL_TOP_K=1
RETRIEVAL_SCORE_THRESHOLD=0.7

# ── Ingestion ────────────────────────────────────────────────────────────────
DOCS_PATH=./data/sample_docs
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ── Application ──────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
DEBUG=false
